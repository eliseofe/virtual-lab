{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-lab.invalid/schemas/run/0.1",
  "title": "Virtual Lab Run",
  "type": "object",
  "required": ["schema_version", "run_id", "experiment_id", "experiment_revision", "seed", "status"],
  "properties": {
    "schema_version": {"const": "vlab.run/0.1"},
    "workspace_id": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_revision": {"type": "integer", "minimum": 1},
    "experiment_hash": {"type": "string"},
    "seed": {"type": "integer"},
    "status": {"enum": ["created", "running", "completed", "failed", "cancelled"]},
    "backend": {"type": "string"},
    "started_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "summary_metrics": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "provenance": {
      "type": "object",
      "properties": {
        "core_version": {"type": "string"},
        "core_commit": {"type": "string"},
        "controller_source_hash": {"type": "string"},
        "controller_ir_hash": {"type": "string"},
        "controller_compiler_version": {"type": "string"},
        "execution_backend": {"type": "string"},
        "actor": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
