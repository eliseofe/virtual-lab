{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-lab.invalid/schemas/registry-experiment/3",
  "title": "Virtual Lab Registry Experiment",
  "type": "object",
  "required": ["schema_version","interface_version","experiment_id","owner_id","title","lifecycle","revision","artifacts","created_at","updated_at"],
  "properties": {
    "schema_version": {"const": "vlab.registry-experiment/3"},
    "interface_version": {"const": "vlab.experiment-artifacts/3"},
    "experiment_id": {"type": "string", "minLength": 1},
    "owner_id": {"type": "string", "minLength": 1},
    "owner_display_name": {"type": ["string", "null"]},
    "collection_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "lifecycle": {"enum": ["active", "archived"]},
    "visibility": {"enum": ["private", "shared", "public"], "default": "private"},
    "revision": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {"contains": {"type": "object", "properties": {"id": {"const": "configuration"}, "type": {"const": "configuration"}}, "required": ["id","type"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "initialization"}, "type": {"const": "initialization"}}, "required": ["id","type"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "controller"}, "type": {"const": "controller"}}, "required": ["id","type"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "metrics"}, "type": {"const": "metrics"}}, "required": ["id","type"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": ["object", "null"], "properties": {"user_id": {"type": ["string", "null"]}, "actor_type": {"enum": ["human", "ai"]}, "ai_client": {"type": ["string", "null"]}}, "required": ["actor_type"], "additionalProperties": false},
    "updated_by": {"type": ["object", "null"], "properties": {"user_id": {"type": ["string", "null"]}, "actor_type": {"enum": ["human", "ai"]}, "ai_client": {"type": ["string", "null"]}}, "required": ["actor_type"], "additionalProperties": false}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["id","type","label","format","order","content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "order": {"type": "number"},
        "content": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
