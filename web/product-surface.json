    "work_browser_wait_loops": "forbidden",
    "long_running_remote_job_waits": "forbidden",
    "connector_capability_discovery_mid_task": "forbidden",
    "terminal_ci_boundary": "fire_and_forget",
    "allowed_diagnostic_exception": "later_owner_turn_with_specific_failure_identifier"
  },
  "work_tracking": {
    "source": "CURRENT.md",
