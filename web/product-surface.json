{
  "schema": "vlab.product-surface/1",
  "coverage_policy": {
    "source_of_truth": "this manifest",
    "active_surface_requires_smoke": true,
    "hard_timeout_required": true,
    "workflow_must_not_hardcode_surface_checks": true,
    "deployable_completion_requires_green_production_smoke": true,
    "exact_deployed_candidate_marker_required": true
  },
  "surfaces": [
    {
      "id": "experiment-runtime",
      "name": "React/Mantine Simulation + Authoring with authoritative scientific runtime",
      "state": "active",
      "smoke": [
        {
          "script": "web/scripts/browser-smoke.mjs",
          "attempts": 6,
          "delay_seconds": 5,
          "timeout_seconds": 45
        }
      ]
    },
    {
      "id": "react-shell",
      "name": "React/Mantine application shell",
      "state": "active",
      "smoke": [
        {
          "script": "web/scripts/frontend-foundation-smoke.mjs",
          "timeout_seconds": 60
        }
      ]
    },
    {
      "id": "metrics-results",
      "name": "Metrics + React/Mantine live Results",
      "state": "active",
      "smoke": [
        {
          "script": "web/scripts/builtin-metric-smoke.mjs",
          "timeout_seconds": 60
        }
      ]
    },
    {
      "id": "local-result-persistence",
      "name": "Local result persistence",
      "state": "active",
      "smoke": [
        {
          "script": "web/scripts/result-persistence-smoke.mjs",
          "timeout_seconds": 60
        }
      ]
    },
    {
      "id": "responsive-experiment-account",
      "name": "Responsive hierarchy, Experiment management and Account focus",
      "state": "active",
      "smoke": [
        {
          "script": "web/scripts/responsive-smoke.mjs",
          "timeout_seconds": 60
        }
      ]
    },
    {
      "id": "student-onboarding",
      "name": "Student registration + Getting started liveness",
      "state": "active",
      "smoke": [
        {
          "script": "web/scripts/student-onboarding-smoke.mjs",
          "timeout_seconds": 60
        }
      ]
    },
    {
      "id": "showcase",
      "name": "Showcase",
      "state": "active",
      "smoke": [
        {
          "script": "web/scripts/showcase-ux-smoke.mjs",
          "timeout_seconds": 60
        }
      ]
    }
  ]
}
